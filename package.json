{
  "name": "agent-world",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server.js",
    "test": "node i18n.test.js && node chat.test.js && node office.test.js && node server.test.js"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      ".env",
      "chat-server.js",
      "session-registry.js",
      "chat.js",
      "i18n.js",
      "locales",
      "office.js",
      "office-backgrounds.js",
      "index.html",
      "assets"
    ],
    "ext": "js,html,css,json,png,env",
    "delay": "300"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
